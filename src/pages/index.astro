---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5);
---

<Layout title="C A N D Y">
  <div class="pt-32 pb-20 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-12">
        <h1 class="text-5xl md:text-7xl font-display font-bold">Latest Posts</h1>
        <a href="/blog" class="text-primary hover:text-base-content/80 transition-colors duration-200 font-medium">
          View All →
        </a>
      </div>

      <div class="flex flex-col gap-6">
        {
          posts.map((post) => (
            <BlogCard
              title={post.data.title}
              slug={post.id}
              date={post.data.pubDate.split('T')[0]}
              excerpt={post.data.excerpt || ''}
              tags={post.data.tags}
            />
          ))
        }
      </div>
    </div>
  </div>
</Layout>
