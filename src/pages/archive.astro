---
import Layout from '../layouts/Layout.astro';
import ArchiveFilter from '../components/ArchiveFilter';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const postsData = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .map(post => ({
    id: post.id,
    title: post.data.title,
    pubDate: new Date(post.data.pubDate).toISOString().split('T')[0],
  }));
---

<Layout title="Archive | C A N D Y">
  <div class="pt-32 pb-20 px-6">
    <div class="max-w-5xl mx-auto">
      <section class="mb-12">
        <h1 class="text-5xl md:text-7xl font-display font-bold mb-6 text-base-content">Archive</h1>
        <p class="text-xl text-base-content/70">Browse through all posts by date.</p>
      </section>

      <ArchiveFilter client:load posts={postsData} />
    </div>
  </div>
</Layout>
