<footer class="border-t border-border mt-20">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid md:grid-cols-3 gap-8">
      <div class="space-y-4">
        <a
          href="/"
          class="text-2xl font-display font-bold tracking-tight hover:text-primary transition-colors duration-200">
          C A N D Y
        </a>
        <p class="text-muted text-sm leading-relaxed">
          A clean, modern portfolio blog showcasing design and development work.
        </p>
      </div>

      <div>
        <h3 class="font-medium text-sm mb-4 text-off-white">Navigation</h3>
        <div class="flex flex-col gap-2">
          <a href="/" class="text-muted text-sm hover:text-primary transition-colors duration-200"> Home </a>
          <a href="/blog" class="text-muted text-sm hover:text-primary transition-colors duration-200"> Blog </a>
          <a href="/about" class="text-muted text-sm hover:text-primary transition-colors duration-200"> About </a>
        </div>
      </div>

      <div>
        <h3 class="font-medium text-sm mb-4 text-off-white">Connect</h3>
        <div class="flex gap-4">
          <a
            href="https://github.com/lemon-lime-honey"
            target="_blank"
            rel="noopener noreferrer"
            class="text-muted hover:text-primary transition-colors duration-200"
            aria-label="GitHub">
            GitHub
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border">
      <p class="text-center text-muted text-sm">
        Copyright {new Date().getFullYear()} C A N D Y. All rights reserved.
      </p>
    </div>
  </div>
</footer>
