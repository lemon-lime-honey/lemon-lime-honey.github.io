---
import { Code } from 'astro:components';

interface Props {
  url: string;
  lang?: string;
}

const { url, lang } = Astro.props;

const rawUrl = url.replace('github.com', 'raw.githubusercontent.com').replace('/blob/', '/');

const response = await fetch(rawUrl);
let code = await response.text();

const lineMatch = url.match(/#L(\d+)-L(\d+)/);
if (lineMatch) {
  const start = parseInt(lineMatch[1]) - 1;
  const end = parseInt(lineMatch[2]);
  code = code.split('\n').slice(start, end).join('\n');
}

const detectedLang = (lang || url.split('.').pop()?.split('#')[0] || 'text') as any;
---

<div class="border border-base-300 rounded-lg my-8 bg-base-100 overflow-hidden github-code-container">
  <div class="px-4 py-2 bg-base-200 border-b border-base-300 text-sm code-label">
    <a href={url} target="_blank" class="text-base-content/70 no-underline hover:text-primary hover:underline transition-colors">{url.split('/').pop()?.split('#')[0]}</a>
  </div>
  <div class="p-5">
    <Code code={code} lang={detectedLang} theme="github-light-high-contrast" />
  </div>
</div>

<style>
  .github-code-container :global(pre) {
    white-space: pre-wrap !important;
    word-break: break-all !important;
    overflow-x: hidden !important;
    background-color: transparent !important;
  }
</style>
