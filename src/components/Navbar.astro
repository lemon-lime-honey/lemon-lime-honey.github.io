---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
---

<header class="fixed top-0 left-0 right-0 z-50 bg-light/80 backdrop-blur-md border-b border-border">
  <nav class="max-w-6xl mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a
        href="/"
        class="text-2xl font-display font-bold tracking-tight hover:text-primary transition-colors duration-200">
        C A N D Y
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <a
          href="/"
          class={`text-sm font-medium transition-colors duration-200 ${isActive('/') ? 'text-primary' : 'text-muted hover:text-dark'}`}>
          Home
        </a>
        <a
          href="/blog"
          class={`text-sm font-medium transition-colors duration-200 ${isActive('/blog') ? 'text-primary' : 'text-muted hover:text-dark'}`}>
          Blog
        </a>
        <a
          href="/about"
          class={`text-sm font-medium transition-colors duration-200 ${isActive('/about') ? 'text-primary' : 'text-muted hover:text-dark'}`}>
          About
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden text-muted hover:text-dark transition-colors duration-200"
        aria-label="Toggle menu">
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-border">
      <div class="flex flex-col gap-4 pt-4">
        <a href="/" class="text-sm font-medium transition-colors duration-200 text-muted hover:text-primary"> Home </a>
        <a href="/blog" class="text-sm font-medium transition-colors duration-200 text-muted hover:text-primary">
          Blog
        </a>
        <a href="/about" class="text-sm font-medium transition-colors duration-200 text-muted hover:text-primary">
          About
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>
